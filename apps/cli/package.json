{
  "name": "@puffer/cli",
  "version": "0.0.0",
  "description": "Thin commander-based CLI that drives the Puffer daemon",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "puffer": "./dist/index.js"
  },
  "dependencies": {
    "@puffer/audit": "*",
    "@puffer/core": "*",
    "@puffer/daemon": "*",
    "@puffer/discovery": "*",
    "@puffer/engine": "*",
    "@puffer/redteam": "*",
    "@puffer/reports": "*",
    "@puffer/score": "*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
