{
  "name": "openpuffer",
  "version": "0.1.0",
  "description": "The autonomous immune system for AI agents",
  "bin": {
    "puffer": "./apps/cli/dist/index.js"
  },
  "main": "./apps/daemon/dist/index.js",
  "types": "./apps/daemon/dist/index.d.ts",
  "scripts": {
    "build": "tsc -b apps/cli apps/daemon",
    "dev": "tsc -b apps/cli apps/daemon --watch",
    "start": "node apps/daemon/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{ts,js,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"packages/**/src/**/*.ts\" \"apps/**/src/**/*.ts\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,js,json}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"packages/**/src/**/*.ts\" \"apps/**/src/**/*.ts\" \"*.{ts,js,json,md}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "security",
    "firewall",
    "agent",
    "llm",
    "openai",
    "anthropic",
    "ollama",
    "prompt-injection",
    "pii"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/layers/*"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "http-proxy": "^1.18.1",
    "minimatch": "^10.0.1",
    "uuid": "^10.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.12",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^2.0.0"
  }
}
